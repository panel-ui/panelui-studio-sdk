{
  "name": "panelui-studio",
  "version": "0.3.0",
  "description": "Client for PanelUI Studio: feedback, conversations and screenshots for React Native, Expo and web apps (Next.js, React, Vite).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/panel-ui/panelui-studio-sdk.git"
  },
  "homepage": "https://studio.panelui.dev",
  "keywords": [
    "react-native",
    "expo",
    "react",
    "nextjs",
    "vite",
    "web",
    "feedback",
    "panelui",
    "panelui-studio"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./dist/native/index.cjs",
  "exports": {
    ".": {
      "react-native": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/native/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/native/index.cjs"
        }
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsup && node scripts/check-web-build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.74"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "react-native": { "optional": true }
  },
  "devDependencies": {
    "@types/react": "^19",
    "react": "19.2.8",
    "tsup": "^8.5.0",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/panel-ui/panelui-studio-sdk/issues"
  }
}
