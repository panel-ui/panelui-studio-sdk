{
  "name": "panelui-studio",
  "version": "0.2.1",
  "description": "Client for PanelUI Studio: feedback, conversations and screenshots for any React Native or Expo app.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/panel-ui/panelui-studio.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://studio.panelui.dev",
  "keywords": [
    "react-native",
    "expo",
    "feedback",
    "panelui",
    "panelui-studio"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.74"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "react-native": { "optional": true }
  },
  "devDependencies": {
    "@types/react": "^19",
    "react": "19.2.8",
    "tsup": "^8.5.0",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
